# Supabase
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key-here

# Cloudflare Turnstile (optional — captcha is progressive)
VITE_TURNSTILE_SITE_KEY=your-turnstile-site-key-here

# Site domain (used for magic link URLs in production)
VITE_SITE_DOMAIN=lapidim-alumni.org

# Local development only — bypass the magic-link login (see src/lib/devAuth.ts).
# Put these in .env.local, never in CI. Only takes effect on localhost.
# VITE_DEV_FAKE_AUTH=true
# VITE_DEV_FAKE_ROLE=admin
